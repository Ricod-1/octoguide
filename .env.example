# OctoGuide 部署环境变量模板。
# 用法：复制为 .env（同一目录）后按需修改；.env 已被 .gitignore 忽略，不会提交。
#   copy .env.example .env

# ---------- 数据库 ----------
# 必填：MySQL root 密码（仅容器内部使用，不对宿主机暴露 root 端口）。
MYSQL_ROOT_PASSWORD=change-me-root-password

# 必填：后端连接数据库使用的业务账号密码（首次初始化时自动创建该账号）。
OCTOGUIDE_DB_PASSWORD=change-me-app-password

# 数据库名与业务账号名，一般无需改动。
MYSQL_DATABASE=octoguide
OCTOGUIDE_DB_USERNAME=octoguide

# ---------- 端口 ----------
# 前端访问端口，浏览器打开 http://localhost:8088
FRONTEND_HOST_PORT=8088

# 后端 API 端口（仅绑定 127.0.0.1）。若宿主机 8080 已被占用，改成 8081 等。
BACKEND_HOST_PORT=8080

# MySQL 映射到宿主机的端口（仅绑定 127.0.0.1）。本机已有 MySQL 占用 3306 时保持 3307。
MYSQL_HOST_PORT=3307

# ---------- 大模型（可选） ----------
# 留空 OCTOGUIDE_LLM_KEY 时，聊天自动回退到本地知识库，不报错。
# 例：DeepSeek 填 https://api.deepseek.com 与 deepseek-chat。
OCTOGUIDE_LLM_BASE_URL=https://api.openai.com/v1
OCTOGUIDE_LLM_KEY=
OCTOGUIDE_LLM_MODEL=gpt-4o-mini

# 非流式调用（联网研究的网址建议）整次等待上限，单位秒。
OCTOGUIDE_LLM_TIMEOUT_SECONDS=30

# ---------- 功能开关 ----------
# 联网研究：时效性问题自动抓取网页补充回答，true / false。
OCTOGUIDE_WEB_RESEARCH_ENABLED=true

# 知识更新接口（POST /api/knowledge/update）的请求头令牌。
# 留空表示不启用该接口；需要定时同步知识时填一个随机字符串。
OCTOGUIDE_KNOWLEDGE_UPDATE_TOKEN=

# 流式回答超时（秒），需大于 OCTOGUIDE_LLM 流式总时长上限。
OCTOGUIDE_CHAT_EMITTER_TIMEOUT_SECONDS=300

# ---------- JVM ----------
# 内存受限的小机器可调小，例如 -Xms128m -Xmx256m。
JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8
